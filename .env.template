# Zava Retail demo apps — shared credentials (copy to .env and fill in).
# Get these from https://portal.ditto.live → your app.

# --- Apps (Ditto SDK) ---
DITTO_DATABASE_ID=
DITTO_DEVELOPMENT_TOKEN=
DITTO_SERVER_URL=

# --- Data loader (Ditto HTTP API) ---
# Portal → your app → Auth → New API key (needs read+write; requires a portal
# role with "Access API keys"). NOTE: API keys expire after max one year.
DITTO_API_KEY=
# Portal → your app → "Connecting via HTTP" → Cloud URL Endpoint.
# With or without the https:// scheme; may include a path segment.
DITTO_HTTP_API_URL=
