# Ditto Retail demo apps — shared credentials (copy to .env and fill in).
#
# Start here: https://docs.ditto.live/cloud/portal/creating-a-ditto-account
# (create an account), then
# https://docs.ditto.live/cloud/portal/creating-a-new-app (create a database),
# then copy the values from the Portal's Connect tab:
# https://docs.ditto.live/cloud/portal/getting-sdk-connection-details
#
# Get these from https://portal.ditto.live → your database.

# --- Apps (Ditto SDK) ---
# Portal → your database → Connect → Database ID / Websocket URL, and the
# Online Playground Authentication Token under Authentication Mode.
DITTO_DATABASE_ID=
DITTO_DEVELOPMENT_TOKEN=
DITTO_SERVER_URL=

# --- Data loader (Ditto HTTP API) ---
# Portal → your database → Auth → New API key (needs read+write; requires a
# portal role with "Access API keys"). NOTE: API keys expire after max one year.
DITTO_API_KEY=
# Portal → your database → "Connecting via HTTP" → Cloud URL Endpoint.
# With or without the https:// scheme; may include a path segment.
DITTO_HTTP_API_URL=
